# Vertex AI on GCP (preferred for Cloud Run).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Local Gemini API key fallback. Do not commit the real key.
# GOOGLE_API_KEY=

# Global Recon Java service.
RECON_API_BASE_URL=http://127.0.0.1:8080
RECON_USER_EMAIL=tester@company.com

# Async job polling.
RECON_JOB_POLL_SECONDS=2
RECON_JOB_TIMEOUT_SECONDS=180
